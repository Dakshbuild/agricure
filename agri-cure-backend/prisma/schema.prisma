generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String   @default("FARMER") // FARMER, EXPERT, BUYER, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scans     Scan[]
}

model Scan {
  id             String   @id @default(uuid())
  userId         String
  imageUrl       String
  disease        String?
  confidence     Float?
  severity       String?
  treatment      String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
}

model MarketplaceItem {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  category    String   // SEEDS, CROP, FERTILIZER, PESTICIDE
  sellerId    String
  createdAt   DateTime @default(now())
}
